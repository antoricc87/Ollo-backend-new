datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// A clinician as the patient app sees them: a DIRECTORY record (name,
/// specialty, clinic, published availability) — NOT a login. Clinician identity,
/// visits, notes and billing belong to the future clinician service; this row is
/// what it would publish into the patient backend. `externalId` is reserved for
/// that service's id.
model Clinician {
  id                 String               @id @default(uuid())
  externalId         String?              @unique
  email              String?              @unique
  firstName          String
  lastName           String
  phoneNumber        String?
  specialty          String?
  bio                String?
  profileImageUrl    String?
  npiNumber          String?
  clinicName         String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  zipCode            String?
  country            String?
  acceptedInsurances String[]             @default([])
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  bookings           Booking[]
  availabilities     WeeklyAvailability[]
  chats              Chat[]
  careTeamOf         CareTeamMember[]
}

/// The patient's care team = consent grants. Today a row is created when the
/// patient books a clinician; `revokedAt` ends the link. When a clinician
/// service exists, this row is what scopes its access to this patient's data.
model CareTeamMember {
  id          String    @id @default(uuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinicianId String
  clinician   Clinician @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  source      String    @default("BOOKING") // BOOKING | MANUAL | SEED
  addedAt     DateTime  @default(now())
  revokedAt   DateTime?

  @@unique([patientId, clinicianId])
  @@index([patientId])
}

/// One row per clinician-service call through the seam (`/api/seam/*`):
/// which clinician, which patient (when patient-scoped), which resource, and
/// the response status. This is the record a patient can later be shown
/// ("Dr. Rossi viewed your labs on …"). No FK on purpose — access history
/// must outlive both the grant and the directory row.
model SeamAccessLog {
  id                  String   @id @default(uuid())
  clinicianExternalId String?
  clinicianId         String?
  patientId           String?
  method              String
  path                String
  resource            String // health | whoami | snapshot | labs.current | …
  status              Int
  createdAt           DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([clinicianExternalId, createdAt])
}

model WeeklyAvailability {
  id            String              @id @default(uuid())
  clinician     Clinician           @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  clinicianId   String
  weekStartDate String
  weekEndDate   String
  days          DailyAvailability[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model DailyAvailability {
  id               String             @id @default(uuid())
  weekAvailability WeeklyAvailability @relation(fields: [weekId], references: [id], onDelete: Cascade)
  weekId           String
  date             String
  slots            TimeSlot[]
  isCancelled      Boolean            @default(false)
}

model TimeSlot {
  id                  String            @id @default(uuid())
  dailyAvailability   DailyAvailability @relation(fields: [dailyAvailabilityId], references: [id], onDelete: Cascade)
  dailyAvailabilityId String
  startTime           String
  endTime             String
  isBooked            Boolean           @default(false)
  isAvailable         Boolean
}

model ResetPassword {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean
}

// Patient Modules
model Patient {
  id                   String                @id @default(uuid())
  firstName            String?
  lastName             String?
  middleName           String?
  dob                  DateTime?
  gender               String?
  profilePicture       String?               @default("https://upload.wikimedia.org/wikipedia/commons/2/2c/Default_pfp.svg")
  summary              Json?
  password             String?
  email                String                @unique
  patientSummary       PatientSummary?
  onBoardingComplete   Boolean               @default(false)
  lastSectionCompleted String?
  consentAcceptedAt    DateTime?
  /// Annual physical (onboarding Set 04): "within_year" | "over_year" | "never"
  lastPhysicalStatus   String?
  lastPhysicalAt       DateTime?
  healthPlans          HealthPlan[]          @relation("PatientPlans")
  mealPlans            MealPlan[]            @relation("PatientMealPlans")
  createdAt            DateTime?             @default(now())
  resetPassword        ResetPassword[]
  timeZone             String?
  phoneNumber          String?
  bookings             Booking[]
  careTeam             CareTeamMember[]
  instacartPreferences InstacartPreferences?
  insurance            PatientInsurance?
  isProUser            Boolean               @default(false)
  proActivatedAt       String?
  proExpiresAt         String?
  avatar               Int?
  freeTrialEndsOn      DateTime?
  dexcomToken          DexcomToken?
  subAccountOf         String? // NEW: Reference to parent patient
  parentPatient        Patient?              @relation("SubAccounts", fields: [subAccountOf], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subAccounts          Patient[]             @relation("SubAccounts")
  chats                Chat[]
  agentThreads         AgentThread[]
  agentMemories        AgentMemory[]
  agentAuditLogs       AgentAuditLog[]
  agentProposals       AgentProposal[]
  workoutSessions      WorkoutSession[]      @relation("PatientWorkouts")
  workoutPlans         WorkoutPlan[]         @relation("PatientWorkoutPlans")
  trainingProfile      TrainingProfile?
  agentPreference      AgentPreference?
  labJourneys          LabJourney[]          @relation("PatientLabJourneys")
  encounters           Encounter[]           @relation("PatientEncounters")
  findings             Finding[]             @relation("PatientFindings")
  nightlyVitals        NightlyVitals[]       @relation("PatientNightlyVitals")
  devices              Device[]
  notifications        Notification[]
}

model DexcomToken {
  id           String   @id @default(uuid())
  patientId    String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model InstacartPreferences {
  id                String  @id @default(uuid())
  patientId         String  @unique
  patient           Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  retailer_key      String
  retailer_logo_url String
  retailer_name     String
}

model PatientSummary {
  id            String                @id @default(uuid())
  patientId     String                @unique // Ensure uniqueness
  patient       Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  summary       String?
  immunizations String[]
  allergies     AllergySummary[]
  conditions    ConditionSummary[]
  medications   MedicationSummary[]
  procedures    ProcedureSummary[]
  labResults    LabResultSummary[]
  caloricAmount Int?
  exercise      ExerciseSummary?      @relation
  familyHistory FamilyHistorySummary? @relation
  nutrition     NutritionSummary?     @relation
  vitals        VitalsSummary?        @relation
}

model VitalsSummary {
  id                 String         @id @default(uuid())
  weight             Float
  weight_unit        String?
  height_unit        String?
  height             Float
  isSmoker           Boolean?
  bfp                Float?
  sBp                Int?
  dBp                Int?
  alcoholConsumption String?
  smokingHabit       String?
  caffeine           String?
  activityLevel      String?
  drugUse            String[]
  ethnicity          String?
  patientSummary     PatientSummary @relation(fields: [patientSummaryId], references: [id])
  patientSummaryId   String         @unique
}

model ExerciseSummary {
  id               String         @id @default(uuid())
  frequency        String
  preferences      String[]
  patientSummary   PatientSummary @relation(fields: [patientSummaryId], references: [id])
  patientSummaryId String         @unique
}

model FamilyHistorySummary {
  id                             String         @id @default(uuid())
  historyOfChronicConditions     String[]
  historyOfCancer                String[]
  historyOfMentalHealth          String[]
  historyOfStroke                Boolean
  historyOfHeartAttack           Boolean
  historyOfHereditaryConditions  String[]
  historyOfHighCholesterol       Boolean
  historyOfHighTriglyceride      Boolean
  historyOfAutoimmuneConditions  String[]
  historyOfKidneyDisease         Boolean
  historyOfRespiratoryConditions Boolean
  historyOfDementiaOrAlzheimer   Boolean
  patientSummary                 PatientSummary @relation(fields: [patientSummaryId], references: [id])
  patientSummaryId               String         @unique
}

model AllergySummary {
  id               String         @id @default(uuid())
  patientSummaryId String
  allergyId        String
  patientSummary   PatientSummary @relation(fields: [patientSummaryId], references: [id])
  allergy          Allergy        @relation(fields: [allergyId], references: [id], onDelete: Cascade)
}

model Allergy {
  id               String           @id @default(uuid())
  substance        String           @unique
  status           String
  reactions        String[]
  allergySummaries AllergySummary[]
}

model Condition {
  id                 String             @id @default(uuid())
  name               String             @unique
  clinicalStatus     String
  verificationStatus String
  onset              String
  conditionSummaries ConditionSummary[]
}

model ConditionSummary {
  id               String         @id @default(uuid())
  patientSummaryId String
  conditionId      String
  patientSummary   PatientSummary @relation(fields: [patientSummaryId], references: [id])
  condition        Condition      @relation(fields: [conditionId], references: [id], onDelete: Cascade)
}

model Medication {
  id                  String              @id @default(uuid())
  name                String              @unique
  dosage              String
  status              String
  medicationSummaries MedicationSummary[]
}

model MedicationSummary {
  id               String         @id @default(uuid())
  patientSummaryId String
  medicationId     String
  patientSummary   PatientSummary @relation(fields: [patientSummaryId], references: [id])
  medication       Medication     @relation(fields: [medicationId], references: [id], onDelete: Cascade)
}

model Procedure {
  id                 String             @id @default(uuid())
  name               String             @unique
  period             String
  procedureSummaries ProcedureSummary[]
}

model ProcedureSummary {
  id               String         @id @default(uuid())
  patientSummaryId String
  procedureId      String
  patientSummary   PatientSummary @relation(fields: [patientSummaryId], references: [id])
  procedure        Procedure      @relation(fields: [procedureId], references: [id], onDelete: Cascade)
}

model LabResult {
  id                 String           @id @default(uuid())
  category           String
  testType           String
  referenceRange     String
  isOutOfRange       Boolean
  result             String
  units              String?
  aboutTestType      String
  needsReview        Boolean          @default(false) // extraction could not verify this value against the PDF
  reviewReason       String?
  sourceRow          String? // the (redacted) PDF row the value was read from
  labResultSummaryId String
  labResultSummary   LabResultSummary @relation("LabResultsForSummary", fields: [labResultSummaryId], references: [id], onDelete: Cascade)
}

model LabResultSummary {
  id               String         @id @default(uuid())
  patientSummaryId String
  patientSummary   PatientSummary @relation(fields: [patientSummaryId], references: [id])
  labResults       LabResult[]    @relation("LabResultsForSummary") // <-- Added matching relation name
  labReport        String
  recommendations  Json
  createdAt        DateTime       @default(now()) // upload time
  collectedAt      DateTime? // when the sample was taken (test date); null on legacy rows → treated as createdAt
}

model NutritionSummary {
  id                 String         @id @default(uuid())
  patientSummaryId   String         @unique
  patientSummary     PatientSummary @relation(fields: [patientSummaryId], references: [id], onDelete: Cascade)
  foodIntollerances  String[]
  foodAllergies      String[]
  foodILike          String[]
  foodIDontLike      String[]
  foodsToAvoid       String[]
  foodsToIncrease    String[]
  dietaryPreferences String[]
  hydrationHabits    String?
  supplements        Supplement[]   @relation("NutritionSupplements")
}

model Supplement {
  id                 String           @id @default(uuid())
  name               String
  quantity           String
  description        String
  nutritionSummaryId String
  nutritionSummary   NutritionSummary @relation(fields: [nutritionSummaryId], references: [id], onDelete: Cascade, name: "NutritionSupplements")
}

//Glucose trackers
model GlucoseTracker {
  id            String          @id @default(uuid())
  userId        String          @unique
  createdAt     DateTime        @default(now())
  dailyEntries  DailyGlucose[]  @relation("TrackerToDaily") // Named relation
  weeklyEntries WeeklyGlucose[] @relation("TrackerToWeekly") // Named relation
}

model DailyGlucose {
  id              String         @id @default(uuid())
  userId          String
  date            String
  glucoseEntries  GlucoseEntry[] @relation("TrackerToGlucoseEntry")
  weeklyTrackerId String // Removed @unique
  weeklyTracker   WeeklyGlucose  @relation("TrackerToDaily", fields: [weeklyTrackerId], references: [id], onDelete: Cascade)
  trackerId       String
  tracker         GlucoseTracker @relation("TrackerToDaily", fields: [trackerId], references: [id], onDelete: Cascade) // Cascade delete
}

model WeeklyGlucose {
  id            String         @id @default(uuid())
  userId        String
  weekStartDate String
  weekEndDate   String
  dailyEntries  DailyGlucose[] @relation("TrackerToDaily")
  trackerId     String
  tracker       GlucoseTracker @relation("TrackerToWeekly", fields: [trackerId], references: [id], onDelete: Cascade) // Cascade delete
}

model GlucoseEntry {
  id             String       @id @default(uuid())
  value          Float
  createdAt      String
  dailyTrackerId String
  dailyTracker   DailyGlucose @relation("TrackerToGlucoseEntry", fields: [dailyTrackerId], references: [id], onDelete: Cascade)
}

// Blood Pressure Tracker
model BloodPressureTracker {
  id            String                @id @default(uuid())
  userId        String                @unique
  createdAt     DateTime              @default(now())
  dailyEntries  DailyBloodPressure[]  @relation("TrackerToDaily") // Named relation
  weeklyEntries WeeklyBloodPressure[] @relation("TrackerToWeekly") // Named relation
}

model DailyBloodPressure {
  id              String               @id @default(uuid())
  userId          String
  date            String
  bpEntries       BloodPressureEntry[] @relation("TrackerToBPEntry")
  weeklyTrackerId String // Removed @unique
  weeklyTracker   WeeklyBloodPressure  @relation("TrackerToDaily", fields: [weeklyTrackerId], references: [id], onDelete: Cascade)
  trackerId       String
  tracker         BloodPressureTracker @relation("TrackerToDaily", fields: [trackerId], references: [id], onDelete: Cascade) // Cascade delete
}

model WeeklyBloodPressure {
  id            String               @id @default(uuid())
  userId        String
  weekStartDate String
  weekEndDate   String
  dailyEntries  DailyBloodPressure[] @relation("TrackerToDaily")
  trackerId     String
  tracker       BloodPressureTracker @relation("TrackerToWeekly", fields: [trackerId], references: [id], onDelete: Cascade) // Cascade delete
}

model BloodPressureEntry {
  id             String             @id @default(uuid())
  systolic       Int
  diastolic      Int
  pulse          Int? // Optional, if you want to track pulse
  createdAt      String
  dailyTrackerId String
  dailyTracker   DailyBloodPressure @relation("TrackerToBPEntry", fields: [dailyTrackerId], references: [id], onDelete: Cascade)
}

// Calories Trackers
model CaloriesTracker {
  id            String           @id @default(uuid())
  userId        String           @unique
  createdAt     DateTime         @default(now())
  dailyEntries  DailyCalories[]  @relation("TrackerToDaily") // Named relation
  weeklyEntries WeeklyCalories[] @relation("TrackerToWeekly") // Named relation
}

model DailyCalories {
  id             String          @id @default(uuid())
  userId         String
  caloriesBurned Int
  caloriesIntake Int
  date           String
  trackerId      String
  tracker        CaloriesTracker @relation("TrackerToDaily", fields: [trackerId], references: [id], onDelete: Cascade) // Cascade delete
}

model WeeklyCalories {
  id            String          @id @default(uuid())
  userId        String
  weekStartDate String
  weekEndDate   String
  totalBurned   Int
  totalIntake   Int
  trackerId     String
  tracker       CaloriesTracker @relation("TrackerToWeekly", fields: [trackerId], references: [id], onDelete: Cascade) // Cascade delete
}

// Exercises Trackers
model ExerciseTracker {
  id            String           @id @default(uuid())
  userId        String           @unique
  createdAt     DateTime         @default(now())
  dailyEntries  DailyExercise[]  @relation("TrackerToDaily") // Named relation
  weeklyEntries WeeklyExercise[] @relation("TrackerToWeekly") // Named relation
}

model DailyExercise {
  id                String          @id @default(uuid())
  userId            String
  minutesOfExercise Int
  date              String
  trackerId         String
  tracker           ExerciseTracker @relation("TrackerToDaily", fields: [trackerId], references: [id], onDelete: Cascade) // Cascade delete
}

model WeeklyExercise {
  id                String          @id @default(uuid())
  userId            String
  weekStartDate     String
  weekEndDate       String
  minutesOfExercise Int
  trackerId         String
  tracker           ExerciseTracker @relation("TrackerToWeekly", fields: [trackerId], references: [id], onDelete: Cascade) // Cascade delete
}

// Weight Trackers
model WeightTracker {
  id            String        @id @default(uuid())
  userId        String        @unique
  createdAt     DateTime      @default(now())
  weightEntries WeightEntry[] @relation("TrackerToWeightEntry")
}

model WeightEntry {
  id        String        @id @default(uuid())
  createdAt String
  weight    Float
  unit      String
  trackerId String
  tracker   WeightTracker @relation("TrackerToWeightEntry", fields: [trackerId], references: [id], onDelete: Cascade)
}

// Body fat percentage Trackers
model BFPTracker {
  id         String     @id @default(uuid())
  userId     String     @unique
  createdAt  DateTime   @default(now())
  BFPEntries BFPEntry[] @relation("TrackerToBFPEntry")
}

model BFPEntry {
  id         String     @id @default(uuid())
  createdAt  String
  percentage Float
  trackerId  String
  tracker    BFPTracker @relation("TrackerToBFPEntry", fields: [trackerId], references: [id], onDelete: Cascade)
}

// Food Trackers
model FoodTracker {
  id            String       @id @default(uuid())
  userId        String       @unique
  createdAt     DateTime     @default(now())
  dailyEntries  DailyFood[]  @relation("TrackerToDailyFood") // Named relation
  weeklyEntries WeeklyFood[] @relation("TrackerToWeeklyFood") // Named relation
}

model FoodEntry {
  id                String           @id @default(uuid())
  description       String
  quantity          String
  calories          Int
  dailyFoodId       String // Foreign key to DailyFood
  dailyFood         DailyFood        @relation(fields: [dailyFoodId], references: [id], onDelete: Cascade) // Cascade delete
  mealType          String? // (e.g., BREAKFAST, LUNCH, DINNER, SNACK)
  favMealId         String?
  favMeal           FavMeal?         @relation(fields: [favMealId], references: [id])
  carbohydrates     Float?
  proteins          Float?
  fats              Float?
  fiber             Float?
  sodium            Float?
  naturalSugar      Float?
  addedSugar        Float?
  calcium           Float?
  magnesium         Float?
  iron              Float?
  potassium         Float?
  omega_3           Float?
  cholesterol       Float?
  zinc              Float?
  vitaminD          Float?
  vitaminC          Float?
  vitaminB12        Float?
  vitaminE          Float?
  glycemicLoad      Float? // NEW: Glycemic Load (calculated)
  vegetableServings Float? // NEW: Vegetable servings
  fruitServings     Float? // NEW: Fruit servings
  createdAt         String?
  isProcessedFood   Boolean?
  /// Meal portion dial (light | normal | hearty | lots) chosen for this meal — null on entries logged before it existed. Feeds the per-user portion bias.
  portionStop       String?
  /// How it was logged when not in the moment: "recall" (described 2+ days later) | "usual_day" (a catch-up day filled from the person's normal day). Null = logged live. Counts in every total like any entry.
  source            String?
  ingredients       MealIngredient[] // Phase 3: per-ingredient breakdown (source of truth for the totals above)
}

model FavMeal {
  id                String              @id @default(uuid())
  userId            String
  mealType          MealType
  /// "This is my usual <slot>" — null when the favourite is just a named dish.
  /// A slot lets "my usual breakfast" resolve without naming the dish.
  slot              MealType?
  /// Extra names the user calls it ("the tuna thing"), matched alongside `description`.
  aliases           String[]            @default([])
  useCount          Int                 @default(0)
  lastUsedAt        DateTime?
  /// Per-ingredient rows — the source of truth. Logging a favourite copies these
  /// verbatim: no model call, no USDA call, same numbers every time.
  ingredients       FavMealIngredient[]
  /// LEGACY (pre-2026-08-31): favourites used to be a bag of FoodEntry rows with
  /// no per-ingredient detail. Backfilled into `ingredients` by
  /// scripts/backfill-fav-meal-ingredients.ts; drop this relation and
  /// FoodEntry.favMealId once every environment has been backfilled.
  legacyEntries     FoodEntry[]
  description       String
  quantity          String
  calories          Int?
  carbohydrates     Float?
  proteins          Float?
  fats              Float?
  fiber             Float?
  sodium            Float?
  naturalSugar      Float?
  addedSugar        Float?
  calcium           Float?
  magnesium         Float?
  iron              Float?
  potassium         Float?
  omega_3           Float?
  cholesterol       Float?
  zinc              Float?
  vitaminD          Float?
  vitaminC          Float?
  vitaminB12        Float?
  vitaminE          Float?
  glycemicLoad      Float?
  vegetableServings Float?
  fruitServings     Float?
  createdAt         String?
  isProcessedFood   Boolean?

  @@index([userId])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model FavFood {
  id              String   @id @default(uuid())
  patientId       String
  description     String
  quantity        String
  calories        Int
  carbohydrates   Float?
  proteins        Float?
  fats            Float?
  fiber           Float?
  sodium          Float?
  naturalSugar    Float?
  addedSugar      Float?
  calcium         Float?
  magnesium       Float?
  iron            Float?
  potassium       Float?
  omega_3         Float?
  cholesterol     Float?
  zinc            Float?
  vitaminD        Float?
  vitaminC        Float?
  vitaminB12      Float?
  vitaminE        Float?
  createdAt       String?
  isProcessedFood Boolean?
}

// ---------------------------------------------------------------------------
// Meal ingredients (Phase 3) — one row per food inside a logged FoodEntry.
// Totals on FoodEntry are recomputed from these whenever they are edited.
// ---------------------------------------------------------------------------
/// Mirrors MealIngredient column for column, so `toPrismaIngredient` and the
/// rest of calories_tracker/model/mealIngredients.ts serve both.
model FavMealIngredient {
  id                   String   @id @default(uuid())
  favMealId            String
  favMeal              FavMeal  @relation(fields: [favMealId], references: [id], onDelete: Cascade)
  sortOrder            Int      @default(0)
  name                 String
  searchTerm           String?
  brand                String?
  quantity             Float
  unit                 String
  grams                Float
  gramsLow             Float?
  gramsHigh            Float?
  portionSource        String?
  portionAssumption    String?
  confidence           Float?
  foodGroup            String?
  isProcessedFood      Boolean?
  glycemicIndex        Float?
  calories             Float
  nutrients            Json
  per100g              Json?
  nutrientSource       String?
  referenceSource      String?
  referenceId          String?
  referenceDescription String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([favMealId])
}

model MealIngredient {
  id                   String    @id @default(uuid())
  foodEntryId          String
  foodEntry            FoodEntry @relation(fields: [foodEntryId], references: [id], onDelete: Cascade)
  sortOrder            Int       @default(0)
  name                 String
  searchTerm           String?
  brand                String?
  quantity             Float
  unit                 String
  grams                Float
  gramsLow             Float?
  gramsHigh            Float?
  portionSource        String? // user | brand | personalized_default | standard_serving
  portionAssumption    String?
  confidence           Float?
  foodGroup            String?
  isProcessedFood      Boolean?
  glycemicIndex        Float?
  calories             Float
  nutrients            Json // nutrients for `grams` (carbohydrates, proteins, fats, saturatedFats, fiber, sodium, ...)
  per100g              Json? // reference vector when nutrientSource = usda
  nutrientSource       String? // usda | llm
  referenceSource      String?
  referenceId          String?
  referenceDescription String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([foodEntryId])
}

model DailyFood {
  id          String      @id @default(uuid())
  userId      String
  date        String
  foodEntries FoodEntry[]
  trackerId   String
  tracker     FoodTracker @relation("TrackerToDailyFood", fields: [trackerId], references: [id], onDelete: Cascade) // Cascade delete
}

model WeeklyFood {
  id            String      @id @default(uuid())
  userId        String
  weekStartDate DateTime
  weekEndDate   DateTime
  trackerId     String
  tracker       FoodTracker @relation("TrackerToWeeklyFood", fields: [trackerId], references: [id], onDelete: Cascade) // Cascade delete
}

// Nutrients Tracker
model MacroNutrientsTracker {
  id                 String            @id @default(uuid())
  userId             String            @unique
  createdAt          DateTime          @default(now())
  dailyEntries       DailyNutrients[]  @relation("TrackerToDailyNutrients") // Named relation
  weeklyEntries      WeeklyNutrients[] @relation("TrackerToWeeklyNutrients") // Named relation
  carbohydratesLimit Float             @default(0)
  proteinsLimit      Float             @default(0)
  fatsLimit          Float             @default(0)
  fiberLimit         Float             @default(0)
  sodiumLimit        Float             @default(0)
  naturalSugarLimit  Float             @default(0)
  addedSugarLimit    Float             @default(0)
  calciumLimit       Float             @default(0)
  magnesiumLimit     Float             @default(0)
