// ---------------------------------------------------------------------------
// Health Plan v1 (Aug 2026) — goal -> pillar targets + nutrition watch-outs.
// Replaces the legacy HealthGoal/TrackableMetric flow for the mobile app;
// legacy tables are left untouched for the doctor portal.
// ---------------------------------------------------------------------------

enum PlanOutcome {
  LOSE_WEIGHT
  RECOMPOSITION
  GENERAL_HEALTH
  FIX_LAB
}

enum PlanIntensity {
  GENTLE
  STEADY
  AMBITIOUS
}

enum PlanStatus {
  ACTIVE
  PAUSED
  COMPLETED
  REPLACED
}

enum PlanPillar {
  SLEEP
  EXERCISE
  NUTRITION
}

enum PlanCadence {
  DAILY
  WEEKLY
}

enum WatchOutLevel {
  WATCH
  LIMIT
}

model HealthPlan {
  id            String         @id @default(uuid())
  patientId     String
  patient       Patient        @relation("PatientPlans", fields: [patientId], references: [id], onDelete: Cascade)
  outcome       PlanOutcome
  intensity     PlanIntensity
  status        PlanStatus     @default(ACTIVE)
  outcomeMetric String? // "weight" | "bfp" | lab test type
  outcomeStart  Float?
  outcomeTarget Float?
  outcomeUnit   String?
  labKey        String? // FIX_LAB: which lab test
  startedAt     DateTime       @default(now())
  endedAt       DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  targets       PlanTarget[]
  watchOuts     PlanWatchOut[]
}

model PlanTarget {
  id        String      @id @default(uuid())
  planId    String
  plan      HealthPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  pillar    PlanPillar
  metricKey String // sleep_minutes | exercise_sessions | calories | protein_g | carbs_g | fat_g
  cadence   PlanCadence
  min       Float?
  max       Float?
  unit      String
  baseline  Float?
  tolerance Float       @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model PlanWatchOut {
  id          String        @id @default(uuid())
  planId      String
  plan        HealthPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  nutrientKey String // sodium | cholesterol | saturated_fat | added_sugar | alcohol
  level       WatchOutLevel @default(WATCH)
  limit       Float?
  unit        String?
  reason      String?
  createdAt   DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Food reference cache (Phase 2 — nutrient resolution)
// Per-100 g reference data pulled from USDA FoodData Central (or a future
// second source), plus the search-term aliases that resolved to it.
// ---------------------------------------------------------------------------
model FoodReference {
  id          String               @id @default(uuid())
  source      String // "usda"
  sourceId    String // fdcId
  dataType    String? // Foundation | SR Legacy | Survey (FNDDS) | Branded
  description String
  brand       String?
  per100g     Json // { calories, carbohydrates, proteins, ... } per 100 g, Ollo field names/units
  portions    Json? // [{ label, gramWeight }]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  aliases     FoodReferenceAlias[]

  @@unique([source, sourceId])
}

model FoodReferenceAlias {
  id          String         @id @default(uuid())
  term        String // normalised search term
  brand       String         @default("") // "" when no brand
  referenceId String? // null = searched, nothing acceptable found (negative cache)
  reference   FoodReference? @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  score       Float?
  method      String? // heuristic | rerank | none
  createdAt   DateTime       @default(now())

  @@unique([term, brand])
}

// ---------------------------------------------------------------------------
// Ollie agent (Aug 2026) — persisted conversations, long-term memory, audit.
// Replaces the in-process Map the LangGraph agents kept per threadId.
// ---------------------------------------------------------------------------
enum AgentThreadSource {
  CHAT // opened by the user in the app
  PROACTIVE // opened by a job (weekly plan review, daily check-in, watch-out)
}

enum AgentRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

enum AgentMemoryCategory {
  PREFERENCE // "hates cilantro", "prefers 20-min workouts"
  ROUTINE // "travels Tuesdays, eats out", "trains at 7am"
  CONSTRAINT // "no dairy at home", "shift work — sleeps 9am-4pm"
  CONTEXT // "mom has T2D", "wedding on Oct 12"
  FEEDBACK // "found the last meal plan too repetitive"
}

model AgentThread {
  id             String            @id @default(uuid())
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  source         AgentThreadSource @default(CHAT)
  title          String?
  summary        String? // rolling summary of turns older than the verbatim window
  summarizedUpTo Int? // highest message seq folded into `summary`
  lastMessageAt  DateTime?
  archivedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  messages       AgentMessage[]

  @@index([patientId, lastMessageAt])
}

model AgentMessage {
  id         String      @id @default(uuid())
  threadId   String
  thread     AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  seq        Int // 1-based position in the thread
  role       AgentRole
  content    String      @default("") // user/assistant text, or the tool result (JSON string) for TOOL rows
  toolCalls  Json? // ASSISTANT: [{ id, name, input }]
  toolCallId String? // TOOL: id of the call this row answers
  toolName   String?
  cards      Json? // typed UI cards emitted with this message
  meta       Json? // model, usage, latencyMs, safety verdict, snapshotHash
  createdAt  DateTime    @default(now())

  @@unique([threadId, seq])
  @@index([threadId, createdAt])
}

model AgentMemory {
  id         String              @id @default(uuid())
  patientId  String
  patient    Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  category   AgentMemoryCategory @default(CONTEXT)
  content    String // one short fact, in the user's terms
  sourceMsg  String? // AgentMessage id the fact was learned from
  active     Boolean             @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([patientId, active])
}

model AgentAuditLog {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  threadId  String?
  messageId String?
  event     String // tool_call | tool_commit | safety_flag | red_flag | response | error
  toolName  String?
  payload   Json? // input/output/verdict — never raw PHI beyond what the tool needed
  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([threadId])
}

enum AgentProposalStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  FAILED
}

/// A write the agent wants to make, awaiting the user's confirmation in the
/// app. `preview` is what the user sees (and can edit); `commit` re-validates
/// the edited input and runs the same service code the app's own UI uses.
model AgentProposal {
  id          String              @id @default(uuid())
  patientId   String
  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  threadId    String?
  toolName    String
  title       String
  summary     String
  input       Json // validated tool input the proposal was built from
  preview     Json // tool-specific preview payload shown in the card
  status      AgentProposalStatus @default(PENDING)
  result      Json? // commit result (or error)
  expiresAt   DateTime
  confirmedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([patientId, status, createdAt])
  @@index([threadId])
}

/// Per-user switches for the agent's proactive runs. Absent row = defaults.
model AgentPreference {
  id                 String    @id @default(uuid())
  patientId          String    @unique
  patient            Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  proactiveEnabled   Boolean   @default(true) // master switch
  dailyCheckinHour   Int? // local hour 0-23; null = off
  weeklyReviewEnabled Boolean  @default(true) // Monday morning plan review
  watchOutsEnabled   Boolean   @default(true) // event-driven nudges (new labs, BP)
  lastDailyCheckinAt DateTime?
  lastWeeklyReviewAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/* ------------------------------ Workouts ------------------------------- */

/// Where the session record came from. HEALTHKIT = synced summary of a watch/
/// phone workout; OLLIE = described to the agent (may be linked to a HealthKit
/// workout via externalId); MANUAL = entered in the app.
enum WorkoutSource {
  HEALTHKIT
  OLLIE
  MANUAL
}

/// One physical training session. Metrics (calories, heart rate, zones) come
/// from the linked HealthKit workout when there is one, otherwise estimated.
/// Heart-rate traces are never stored — the phone reads them from HealthKit.
model WorkoutSession {
  id            String            @id @default(uuid())
  patientId     String
  patient       Patient           @relation("PatientWorkouts", fields: [patientId], references: [id], onDelete: Cascade)
  source        WorkoutSource
  externalId    String? // HealthKit workout UUID (dedup key for sync)
  activityKey   String // canonical activity kind (domain/activity.catalog.ts)
  title         String? // "Push day" — user/agent naming, optional
  startedAt     DateTime
  endedAt       DateTime
  durationSec   Int
  calories      Int?
  metricsSource String? // watch | estimate | user
  distanceKm    Float?
  avgHr         Int?
  peakHr        Int?
  lowHr         Int?
  zoneSeconds   Int[] // 5 entries, Easy → Peak
  rpe           Int? // 1–10, user-reported
  notes         String?
  description   String? // what the user said, verbatim
  deletedAt     DateTime? // soft delete (removed from Health, or by the user)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  exercises     WorkoutExercise[]

  @@unique([patientId, externalId])
  @@index([patientId, startedAt])
}

model WorkoutExercise {
  id          String         @id @default(uuid())
  sessionId   String
  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sortOrder   Int            @default(0)
  exerciseKey String // canonical key (domain/exercise.catalog.ts) or "custom:<slug>"
  name        String // display name as logged
  muscleGroup String?
  equipment   String?
  notes       String?
  sets        WorkoutSet[]

  @@index([sessionId])
  @@index([exerciseKey])
}

model WorkoutSet {
  id          String          @id @default(uuid())
  exerciseId  String
  exercise    WorkoutExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sortOrder   Int             @default(0)
  reps        Int?
  weightKg    Float?
  durationSec Int?
  distanceM   Float?
  rpe         Float?
  toFailure   Boolean         @default(false)
  isWarmup    Boolean         @default(false)

  @@index([exerciseId])
}

/// Labs journey (Aug 2026): one row per attempt to get labs. The panel is
/// recomputed live from the profile; `panel` is the snapshot at start.
enum LabRoute {
  OWN_DOCTOR
  DTC
  OLLO_DOCTOR
}

enum LabJourneyStatus {
  RECOMMENDED
  ORDERED
  RESULTED
  CANCELLED
}

model LabJourney {
  id         String           @id @default(uuid())
  patientId  String
  patient    Patient          @relation("PatientLabJourneys", fields: [patientId], references: [id], onDelete: Cascade)
  route      LabRoute
  status     LabJourneyStatus @default(RECOMMENDED)
  panel      Json
  bookingId  String?
  orderedAt  DateTime?
  resultedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([patientId, status])
}
