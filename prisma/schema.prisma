// ---------------------------------------------------------------------------
// Health Plan v1 (Aug 2026) — goal -> pillar targets + nutrition watch-outs.
// Replaced the legacy HealthGoal/TrackableMetric flow (tables dropped 2026-08-29).
// ---------------------------------------------------------------------------

enum PlanOutcome {
  LOSE_WEIGHT
  RECOMPOSITION
  GENERAL_HEALTH
  FIX_LAB
}

enum PlanIntensity {
  GENTLE
  STEADY
  AMBITIOUS
}

enum PlanStatus {
  ACTIVE
  PAUSED
  COMPLETED
  REPLACED
}

enum PlanPillar {
  SLEEP
  EXERCISE
  NUTRITION
}

enum PlanCadence {
  DAILY
  WEEKLY
}

enum WatchOutLevel {
  WATCH
  LIMIT
}

model HealthPlan {
  id            String         @id @default(uuid())
  patientId     String
  patient       Patient        @relation("PatientPlans", fields: [patientId], references: [id], onDelete: Cascade)
  outcome       PlanOutcome
  intensity     PlanIntensity
  status        PlanStatus     @default(ACTIVE)
  outcomeMetric String? // "weight" | "bfp" | lab test type
  outcomeStart  Float?
  outcomeTarget Float?
  outcomeUnit   String?
  labKey        String? // FIX_LAB: which lab test
  startedAt     DateTime       @default(now())
  endedAt       DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  targets       PlanTarget[]
  watchOuts     PlanWatchOut[]
}

// Saved meal plan (Aug 2026) — the day-by-day plan Ollie generated, kept as a
// reference the user can come back to. One ACTIVE per patient; saving a new
// one marks the previous REPLACED. "Logged" is never stored here: it is
// derived from FoodEntry rows for the plan's dates (see meal_plan.model.ts).
model MealPlan {
  id        String         @id @default(uuid())
  patientId String
  patient   Patient        @relation("PatientMealPlans", fields: [patientId], references: [id], onDelete: Cascade)
  subjectId String? // sub-account the plan is for; null = the patient
  title     String
  notes     String?
  startDate String // local YYYY-MM-DD of day 1
  days      Int
  slots     MealType[]     @default([]) // the slots the plan covers ("just dinners" = [DINNER]); empty = the whole day
  status    PlanStatus     @default(ACTIVE)
  targets   Json? // targets the plan was judged against at save time (the covered share for a partial plan)
  fit       Json? // { ok, issues } from the generator's check
  source    String? // "ollie" | "manual"
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  meals     MealPlanMeal[]

  @@index([patientId, status])
}

model MealPlanMeal {
  id            String    @id @default(uuid())
  planId        String
  plan          MealPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  day           Int // 1-based
  position      Int // order within the day
  mealType      MealType
  name          String
  description   String?
  ingredients   String[] // "150 g salmon fillet"
  calories      Int
  proteins      Float
  carbohydrates Float
  fats          Float
  prepMinutes   Int?
  swappedAt     DateTime? // set when the user replaced the generated meal

  @@index([planId, day])
}

model PlanTarget {
  id        String      @id @default(uuid())
  planId    String
  plan      HealthPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  pillar    PlanPillar
  metricKey String // sleep_minutes | exercise_sessions | calories | protein_g | carbs_g | fat_g
  cadence   PlanCadence
  min       Float?
  max       Float?
  unit      String
  baseline  Float?
  tolerance Float       @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model PlanWatchOut {
  id          String        @id @default(uuid())
  planId      String
  plan        HealthPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  nutrientKey String // sodium | cholesterol | saturated_fat | added_sugar | alcohol
  level       WatchOutLevel @default(WATCH)
  limit       Float?
  unit        String?
  reason      String?
  createdAt   DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Food reference cache (Phase 2 — nutrient resolution)
// Per-100 g reference data pulled from USDA FoodData Central (or a future
// second source), plus the search-term aliases that resolved to it.
// ---------------------------------------------------------------------------
model FoodReference {
  id          String               @id @default(uuid())
  source      String // "usda"
  sourceId    String // fdcId
  dataType    String? // Foundation | SR Legacy | Survey (FNDDS) | Branded
  description String
  brand       String?
  per100g     Json // { calories, carbohydrates, proteins, ... } per 100 g, Ollo field names/units
  portions    Json? // [{ label, gramWeight }]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  aliases     FoodReferenceAlias[]

  @@unique([source, sourceId])
}

model FoodReferenceAlias {
  id          String         @id @default(uuid())
  term        String // normalised search term
  brand       String         @default("") // "" when no brand
  referenceId String? // null = searched, nothing acceptable found (negative cache)
  reference   FoodReference? @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  score       Float?
  method      String? // heuristic | rerank | none
  createdAt   DateTime       @default(now())

  @@unique([term, brand])
}

// ---------------------------------------------------------------------------
// Ollie agent (Aug 2026) — persisted conversations, long-term memory, audit.
// Replaces the in-process Map the LangGraph agents kept per threadId.
// ---------------------------------------------------------------------------
enum AgentThreadSource {
  CHAT // opened by the user in the app
  PROACTIVE // opened by a job (weekly plan review, daily check-in, watch-out)
  VOICE // opened hands-free through Siri (agent/voice.ts)
}

enum AgentRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

enum AgentMemoryCategory {
  PREFERENCE // "hates cilantro", "prefers 20-min workouts"
  ROUTINE // "travels Tuesdays, eats out", "trains at 7am"
  CONSTRAINT // "no dairy at home", "shift work — sleeps 9am-4pm"
  CONTEXT // "mom has T2D", "wedding on Oct 12"
  FEEDBACK // "found the last meal plan too repetitive"
}

model AgentThread {
  id             String            @id @default(uuid())
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  source         AgentThreadSource @default(CHAT)
  title          String?
  summary        String? // rolling summary of turns older than the verbatim window
  summarizedUpTo Int? // highest message seq folded into `summary`
  lastMessageAt  DateTime?
  /// PROACTIVE threads: when the person opened the note. Null = not seen yet,
  /// which is what the dashboard announces. A new proactive run on a reused
  /// thread clears it. Set only by the explicit `seen` route — never by a read.
  seenAt         DateTime?
  archivedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  messages       AgentMessage[]

  @@index([patientId, lastMessageAt])
}

model AgentMessage {
  id         String      @id @default(uuid())
  threadId   String
  thread     AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  seq        Int // 1-based position in the thread
  role       AgentRole
  content    String      @default("") // user/assistant text, or the tool result (JSON string) for TOOL rows
  toolCalls  Json? // ASSISTANT: [{ id, name, input }]
  toolCallId String? // TOOL: id of the call this row answers
  toolName   String?
  cards      Json? // typed UI cards emitted with this message
  meta       Json? // model, usage, latencyMs, safety verdict, snapshotHash
  createdAt  DateTime    @default(now())

  @@unique([threadId, seq])
  @@index([threadId, createdAt])
}

model AgentMemory {
  id         String              @id @default(uuid())
  patientId  String
  patient    Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  category   AgentMemoryCategory @default(CONTEXT)
  content    String // one short fact, in the user's terms
  sourceMsg  String? // AgentMessage id the fact was learned from
  active     Boolean             @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([patientId, active])
}

model AgentAuditLog {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  threadId  String?
  messageId String?
  event     String // tool_call | tool_commit | safety_flag | red_flag | response | error
  toolName  String?
  payload   Json? // input/output/verdict — never raw PHI beyond what the tool needed
  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([threadId])
}

enum AgentProposalStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  FAILED
  UNDONE // confirmed, then reversed by the tool's undo (voice "undo", undo_last_log)
}

/// A write the agent wants to make, awaiting the user's confirmation in the
/// app. `preview` is what the user sees (and can edit); `commit` re-validates
/// the edited input and runs the same service code the app's own UI uses.
model AgentProposal {
  id          String              @id @default(uuid())
  patientId   String
  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  threadId    String?
  toolName    String
  title       String
  summary     String
  input       Json // validated tool input the proposal was built from
  preview     Json // tool-specific preview payload shown in the card
  status      AgentProposalStatus @default(PENDING)
  /// Prepared for a card's own button ("Log it"), not shown as a proposal card — never listed as waiting for the user's OK.
  viaCard     Boolean             @default(false)
  result      Json? // commit result (or error)
  expiresAt   DateTime
  confirmedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([patientId, status, createdAt])
  @@index([threadId])
}

/// A phone that can receive pushes. One row per device token; a user may have
/// several (phone + a second phone, Dev + standalone app). APNs tells us when a
/// token dies (410) — `disabledAt` records it and the next registration revives it.
model Device {
  id         String    @id @default(uuid())
  userId     String
  user       Patient   @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique // APNs device token, hex
  platform   String    @default("ios")
  bundleId   String // apns-topic: com.ollohealth.ollo or com.ollohealth.ollo.dev
  apnsEnv    String    @default("production") // "production" | "sandbox" — corrected on BadDeviceToken
  appVersion String?
  lastSeenAt DateTime  @default(now())
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

/// The notification outbox AND delivery log. Every push is a row first; the
/// sender sweep delivers queued rows whose `scheduledFor` has passed. Nothing
/// talks to APNs directly. `kind` is a string on purpose: the catalogue is
/// still being decided and must not need a migration per change.
model Notification {
  id               String    @id @default(uuid())
  userId           String
  user             Patient   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind             String
  dedupeKey        String? // same key sent or queued the same day => duplicate
  title            String
  body             String
  route            String? // in-app path the tap opens, e.g. "ollie?threadId=…"
  threadId         String?
  scheduledFor     DateTime  @default(now())
  status           String    @default("queued") // queued | sent | suppressed | merged | failed
  suppressedReason String? // quiet_hours | budget | toggle_off | duplicate | no_device | no_transport
  error            String?
  sentAt           DateTime?
  apnsId           String?
  openedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, scheduledFor])
}

/// Per-user switches for the agent's proactive runs. Absent row = defaults.
model AgentPreference {
  id                  String    @id @default(uuid())
  patientId           String    @unique
  patient             Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  proactiveEnabled    Boolean   @default(true) // master switch
  dailyCheckinHour    Int? // local hour 0-23; null = off
  weeklyReviewEnabled Boolean   @default(true) // Monday morning plan review
  watchOutsEnabled    Boolean   @default(true) // event-driven nudges (new labs, BP)
  planWeekEnabled     Boolean   @default(true) // Sunday evening: Ollie lays out next week's training
  lastDailyCheckinAt  DateTime?
  lastWeeklyReviewAt  DateTime?
  lastPlanWeekAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/**
 * ------------------------------ Workouts -------------------------------
 */

/// Where the session record came from. HEALTHKIT = synced summary of a watch/
/// phone workout; OLLIE = described to the agent (may be linked to a HealthKit
/// workout via externalId); MANUAL = entered in the app.
enum WorkoutSource {
  HEALTHKIT
  OLLIE
  MANUAL
}

/// PLANNED = designed (by Ollie or the user) for a day, not yet done — the SAME
/// row becomes COMPLETED when the watch sync adopts it or the user logs it.
enum WorkoutStatus {
  PLANNED
  COMPLETED
}

/// One physical training session. Metrics (calories, heart rate, zones) come
/// from the linked HealthKit workout when there is one, otherwise estimated.
/// Heart-rate traces are never stored — the phone reads them from HealthKit.
model WorkoutSession {
  id            String            @id @default(uuid())
  patientId     String
  patient       Patient           @relation("PatientWorkouts", fields: [patientId], references: [id], onDelete: Cascade)
  source        WorkoutSource
  externalId    String? // HealthKit workout UUID (dedup key for sync)
  activityKey   String // canonical activity kind (domain/activity.catalog.ts)
  title         String? // "Push day" — user/agent naming, optional
  startedAt     DateTime
  endedAt       DateTime
  durationSec   Int
  calories      Int?
  metricsSource String? // watch | estimate | user
  distanceKm    Float?
  avgHr         Int?
  peakHr        Int?
  lowHr         Int?
  zoneSeconds   Int[] // 5 entries, Easy → Peak
  rpe           Int? // 1–10, user-reported
  notes         String?
  description   String? // what the user said, verbatim
  /// Planning (Sep 2026): a planned row keeps its slot in startedAt/endedAt
  /// (preferred time on plannedFor) and its prescription in the sets' target*.
  status        WorkoutStatus     @default(COMPLETED)
  plannedFor    String? // local YYYY-MM-DD while PLANNED
  planId        String? // WorkoutPlan header when part of a saved week
  plan          WorkoutPlan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  focus         String? // strength | hypertrophy | conditioning | mobility | endurance | mixed
  place         String? // gym | home | outdoor | anywhere
  muscleGroups  String[]
  why           String? // one line: how it fits the plan / recovery
  warmup        String[]
  cooldown      String[]
  completedAt   DateTime?
  deletedAt     DateTime? // soft delete (removed from Health, or by the user)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  exercises     WorkoutExercise[]

  @@unique([patientId, externalId])
  @@index([patientId, startedAt])
  @@index([patientId, status, plannedFor])
}

model WorkoutExercise {
  id           String         @id @default(uuid())
  sessionId    String
  session      WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sortOrder    Int            @default(0)
  exerciseKey  String // canonical key (domain/exercise.catalog.ts) or "custom:<slug>"
  name         String // display name as logged
  muscleGroup  String?
  equipment    String?
  notes        String?
  loadNote     String? // planned: "same as last time +2.5 kg" / "a weight you could do 12 with"
  alternatives String[] // planned: catalog keys to swap in when kit is busy/missing
  sets         WorkoutSet[]

  @@index([sessionId])
  @@index([exerciseKey])
}

model WorkoutSet {
  id            String          @id @default(uuid())
  exerciseId    String
  exercise      WorkoutExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sortOrder     Int             @default(0)
  reps          Int?
  weightKg      Float?
  durationSec   Int?
  distanceM     Float?
  rpe           Float?
  toFailure     Boolean         @default(false)
  isWarmup      Boolean         @default(false)
  /// Prescription (planned sessions). reps/weightKg above stay the ACTUALS,
  /// null until the session is completed — so planned vs done needs no join.
  targetReps    Int?
  targetRepsMax Int?
  targetKg      Float?
  restSec       Int?

  @@index([exerciseId])
}

/// A saved training week: header only. Its sessions are PLANNED
/// WorkoutSession rows (planId), which become COMPLETED in place.
/// One ACTIVE per patient; saving a new week → previous REPLACED and its
/// still-planned rows soft-deleted (completed ones are history and stay).
model WorkoutPlan {
  id        String           @id @default(uuid())
  patientId String
  patient   Patient          @relation("PatientWorkoutPlans", fields: [patientId], references: [id], onDelete: Cascade)
  subjectId String? // reserved: sub-account the plan is for
  title     String
  notes     String?
  startDate String // local YYYY-MM-DD of day 1
  days      Int
  status    PlanStatus       @default(ACTIVE)
  brief     Json? // { sessionsPerWeek, sessionMinutes, focus, place } it was built from
  fit       Json? // { ok, issues } from the generator's checks
  source    String? // "ollie" | "manual"
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  sessions  WorkoutSession[]

  @@index([patientId, status])
}

/// How the user trains — the structured brief every generated workout reads.
/// `limitations` is repeated to Ollie in the user's words, never interpreted.
model TrainingProfile {
  patientId      String   @id
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  place          String? // gym | home | outdoor | mixed
  equipment      String[] // barbell dumbbell machine cable kettlebell band bodyweight bike rower treadmill
  experience     String? // new | some | experienced
  sessionMinutes Int?
  preferredDays  String[] // mon … sun
  preferredTime  String? // HH:mm local, the slot planned rows are placed at
  limitations    String?
  updatedAt      DateTime @updatedAt
}

/// Labs journey (Aug 2026): one row per attempt to get labs. The panel is
/// recomputed live from the profile; `panel` is the snapshot at start.
enum LabRoute {
  OWN_DOCTOR
  DTC
  OLLO_DOCTOR
}

enum LabJourneyReason {
  ANNUAL_PHYSICAL
  LABS_ONLY
}

enum LabJourneyStatus {
  RECOMMENDED
  ORDERED
  RESULTED
  CANCELLED
}

model LabJourney {
  id         String           @id @default(uuid())
  patientId  String
  patient    Patient          @relation("PatientLabJourneys", fields: [patientId], references: [id], onDelete: Cascade)
  route      LabRoute
  reason     LabJourneyReason @default(LABS_ONLY)
  status     LabJourneyStatus @default(RECOMMENDED)
  panel      Json
  bookingId  String?
  orderedAt  DateTime?
  resultedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([patientId, status])
}

/**
 * ---------------------------- Check-in (encounter) ---------------------------
 * Structured history-taking. See src/services/encounter/domain and
 * docs/ai-check-in-architecture.md in the mobile repo.
 * Self-reported symptoms live HERE and never in PatientSummary. A condition
 * only reaches the record when the patient confirms a clinician made the
 * diagnosis, through the ordinary proposal flow.
 * --------------------------------------------------------------------------
 */

enum EncounterStatus {
  OPEN
  CLOSED
  ABANDONED
}

enum EncounterRoute {
  OWN_DOCTOR
  OLLO_DOCTOR
  TRACKING
  CRISIS
  UNDECIDED
}

enum EncounterTrend {
  BETTER
  SAME
  WORSE
}

model Encounter {
  id              String             @id @default(uuid())
  patientId       String
  patient         Patient            @relation("PatientEncounters", fields: [patientId], references: [id], onDelete: Cascade)
  status          EncounterStatus    @default(OPEN)
  /// Protocol key from encounter/domain/protocols.ts — never a diagnosis label.
  complaintKey    String
  protocolVersion Int
  /// What the patient typed to open the check-in, verbatim.
  complaintText   String
  phase           String
  /// Answered slots, keyed by slot key. Shape owned by the domain layer.
  slots           Json               @default("{}")
  /// Slots already put to the patient, so a skip is not re-asked.
  askedKeys       String[]           @default([])
  /// Tripped red flags. Sticky: entries are added, never removed.
  redFlags        Json               @default("[]")
  turns           Int                @default(0)
  route           EncounterRoute     @default(UNDECIDED)
  bookingId       String?
  threadId        String?
  /// Which consent text the patient accepted, and the region whose copy they saw.
  consentVersion  String?
  region          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  closedAt        DateTime?
  events          EncounterEvent[]
  checkIns        EncounterCheckIn[]

  @@index([patientId, status])
}

/// APPEND-ONLY. The medico-legal record of what was asked, answered and judged.
/// Never updated, never deleted while the encounter exists.
model EncounterEvent {
  id            String    @id @default(uuid())
  encounterId   String
  encounter     Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  seq           Int
  /// "open" | "ask" | "answer" | "red_flag" | "recap" | "route" | "close"
  kind          String
  slotKey       String?
  payload       Json?
  model         String?
  promptVersion String?
  createdAt     DateTime  @default(now())

  @@unique([encounterId, seq])
  @@index([encounterId])
}

model EncounterCheckIn {
  id          String         @id @default(uuid())
  encounterId String
  encounter   Encounter      @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  day         Int
  trend       EncounterTrend
  note        String?
  createdAt   DateTime       @default(now())

  @@index([encounterId])
}

/// One night of sleep-window vitals, as the phone rolled them up from
/// HealthKit. NOT raw samples: one row per night, keyed by the local night
/// the sleep ended on. This is what lets the server re-derive a patient's
/// "usual" and run the signal detectors, and it is the series a clinician
/// sees underneath a Finding. Written only by the phone (idempotent upsert on
/// [patientId, date]) — a night may be re-sent with better data as HealthKit
/// backfills.
model NightlyVitals {
  id              String   @id @default(uuid())
  patientId       String
  patient         Patient  @relation("PatientNightlyVitals", fields: [patientId], references: [id], onDelete: Cascade)
  /// Local night key, YYYY-MM-DD (the day the sleep ENDED on).
  date            String
  asleepMinutes   Int?
  hrvMs           Float?
  sleepingHr      Float?
  restingHr       Float?
  respiratoryRate Float?
  wristTempC      Float?
  /// Where the numbers came from, for provenance on a clinician surface.
  source          String   @default("healthkit")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([patientId, date])
  @@index([patientId, date])
}

enum FindingStatus {
  OPEN
  ONGOING
  RESOLVED
}

/// Whether the finding is something to watch or something that went right.
/// Positive findings are held to a higher bar and a smaller share of the
/// weekly budget (ruling 2026-09-24).
enum FindingDirection {
  CONCERN
  POSITIVE
}

/// One EPISODE of one detector firing — not one notification. A run of low-HRV
/// nights is a single row that opens, is seen again each day it persists, and
/// resolves when the detector goes quiet; the same detector firing again next
/// month is a new row. That is what turns a notification log into a timeline a
/// clinician can read.
///
/// Findings are part of the record (ruling 2026-09-24): retained, not deletable
/// by the patient. Nothing here is a diagnosis — a detector says "unusual for
/// THIS person against their own baseline", which is not the same claim as a
/// lab value outside a clinical reference range. `evidence` and `baseline` are
/// what makes that judgeable after the fact: the numbers that tripped it, and
/// the yardstick as it stood THAT DAY (a rolling "usual" drifts, so a finding
/// from March is not comparable to one from September without it).
model Finding {
  id              String           @id @default(uuid())
  patientId       String
  patient         Patient          @relation("PatientFindings", fields: [patientId], references: [id], onDelete: Cascade)
  /// Detector identity, e.g. "recovery.dip" | "training.stopped" — the key the
  /// cooldown and the dedup are keyed on. Never a diagnosis label.
  detectorKey     String
  /// Bumped when a detector's rule changes, so old rows stay interpretable.
  detectorVersion Int
  status          FindingStatus    @default(OPEN)
  direction       FindingDirection @default(CONCERN)
  /// Current severity on the shared scale (roughly sigma from the patient's
  /// own baseline, or fraction off a plan target) — comparable ACROSS
  /// detectors, which is what lets one weekly budget rank them against
  /// each other instead of tuning ten thresholds.
  severity        Float
  /// Worst severity reached during the episode.
  peakSeverity    Float
  /// The numbers that tripped it: shape owned by the detector.
  evidence        Json
  /// The baseline/target judged against, as it stood when the episode opened.
  baseline        Json?
  firstDetectedAt DateTime
  lastSeenAt      DateTime
  /// Set when the detector has been quiet for its resolve window. Resolution is
  /// derived from the data only — Ollie never asks (ruling 2026-09-24).
  resolvedAt      DateTime?
  /// When this episode was pushed, if it ever won the budget. Null = detected
  /// and on the record, but never worth interrupting anyone for.
  notifiedAt      DateTime?
  /// The PROACTIVE thread the note was written into, when it was notified.
  threadId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  /// The open episode per detector — the uniqueness the dedup relies on — is
  /// enforced in code (`findings.store.ts`), not here: Postgres cannot express
  /// "at most one row with status != RESOLVED".
  @@index([patientId, status])
  @@index([patientId, detectorKey, firstDetectedAt])
  @@index([patientId, notifiedAt])
}
